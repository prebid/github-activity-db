# GitHub Activity DB - environment configuration
# Copy this file to .env and fill in your values. .env is git-ignored; never commit it.

# ------------------------------------------------------------------------------
# GitHub API (required)
# ------------------------------------------------------------------------------
# Personal access token, created at https://github.com/settings/tokens with the `repo`
# scope (private repositories) or `public_repo` (public only); see docs/development.md.
GITHUB_TOKEN=ghp_your_token_here

# ------------------------------------------------------------------------------
# Optional settings (defaults shown)
# ------------------------------------------------------------------------------
# DATABASE_URL=sqlite+aiosqlite:///./github_activity.local.db
# LOG_LEVEL=INFO
# ENVIRONMENT=development

# Tracked repositories file to read instead of the tracking.toml shipped in the package.
# An empty value means the packaged file.
# TRACKING_CONFIG_PATH=
